        }
      ]
    },
    {
      "id": "claim_2c755651ef4448c78700e2f37418bcae",
      "statement": "The CLI is the engine-host-local surface and the only one that skips the network: it exposes the index/reindex/init, converge, read-only retrieve/think/resolve/list-folders, dry-run-by-default `commit-note` (a real guarded write only with `--commit`), memory and client control, hooks, diagnostics, and the `serve`/`serve-cloud`/`setup`/`install` serving and provisioning commands, installed via the single console script `hypermnesic = hypermnesic.cli:main`.",
      "evidence": [
        {
          "resource": "repo://pyproject.toml#L55-L56",
