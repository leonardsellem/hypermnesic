    {
      "id": "claim_21c01a773dd4477f9c083d2891836047",
      "statement": "Because the git commit is the commitment, a failed index projection after a landed commit is reported as a degraded success carrying the new SHA (`index_degraded` plus a reason) and never as an error, while an idempotent edit that changes nothing returns a no-op result and neither commits nor logs.",
      "evidence": [
