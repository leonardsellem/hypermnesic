    {
      "id": "claim_8ec53a5562c24d46a02555cd4cbce01d",
      "statement": "Serving has two network lanes built from one implementation: `build_cloud_server` (public OAuth `/mcp` with DCR, PKCE, and an operator-consent gate; read tools always, `commit_note` gated by the `write` scope) internally calls `build_server` with `write_enabled=True`, whereas `build_server` alone registers no write tool at all by default, making the tailnet read companion structurally read-only.",
      "evidence": [
        {
          "resource": "repo://src/hypermnesic/mcp_server.py#L1-L14",
          "version": "repo-lines-v1:sha256:7cdda4dd113cab8048f0cd24c31daec75d0aa5f44f3b448131aa0a522a5324b6:"
