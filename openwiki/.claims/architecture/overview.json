  "claims": [
    {
      "id": "claim_68262fcd43d5447390d3878f95b3fe31",
      "statement": "The prime invariant is that the git-tracked markdown files are the single source of truth and the search/graph index is a disposable, rebuildable projection of the committed tree: there is no database of record, a reindex can never lose a committed write, and deleting the index destroys nothing because writes go to git first and the index is rebuilt from git.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L19-L24",
          "version": "repo-lines-v1:sha256:b59e61c8768643546810b9c6db1d9b32aff3cbbe3ee2116e0421d996ac3f4e2f:"
        },
        {
          "resource": "repo://ARCHITECTURE.md#L7-L15",
          "version": "repo-lines-v1:sha256:b28a7e3362ce24794f81aae6cfa21140ecb2009dd4f813c3f1abf8bc4e434337:"
        },
        {
          "resource": "repo://src/hypermnesic/__init__.py#L1-L11",
          "version": "repo-lines-v1:sha256:f9ba35b486bf200488a1ffbb3f3e38124c84b4de20b6a87ffba93d852ef35708:"
        }
      ]
    },
    {
      "id": "claim_2b76de93ed7e4570a22ee9c32004069c",
      "statement": "The index is stored as a single SQLite file under the per-repo state directory `<repo>/.hypermnesic/` (directory mode 0700, db file 0600) whose schema holds a `chunks` table, an FTS5 lexical table, sqlite-vec KNN virtual tables for chunks and doc surfaces, and a `meta` checkpoint slot; the engine ignores that state directory by appending a managed entry to `.git/info/exclude` and never mutates the tracked `.gitignore` or any tracked file.",
      "evidence": [
        {
          "resource": "repo://src/hypermnesic/index.py#L1-L10",
          "version": "repo-lines-v1:sha256:0323ab03469a8a4b55768d71dce35d39903ff66f0a4592dbf61589054134ad91:"
        },
        {
          "resource": "repo://src/hypermnesic/index.py#L131-L157",
          "version": "repo-lines-v1:sha256:e4a757f91eb377c28c7edb97a43248cb2ff14dc214e7e7950fcd7d1299e3fc5a:"
        },
        {
          "resource": "repo://src/hypermnesic/index.py#L330-L343",
          "version": "repo-lines-v1:sha256:d6b19aabc57f74c1c00e3b0c5f945a66d8338da1df53db35199adffe2e385ffc:"
