    {
      "id": "claim_6f026a067f514cfe89c19315eb576e40",
      "statement": "Retrieval is hybrid and rank-fused: SQLite FTS5 lexical results and sqlite-vec dense KNN results (plus a doc-surface lane) are combined by Reciprocal Rank Fusion, byte-identical chunk texts are collapsed keeping the highest-ranked copy, and each hit carries a per-path git commit recency (epoch seconds of the most recent commit touching that path) produced by a single `git log` pass and used by consumers for their own forgetting curve, not by engine ranking.",
      "evidence": [
        {
          "resource": "repo://src/hypermnesic/retrieve.py#L183-L203",
          "version": "repo-lines-v1:sha256:ba7194d09a20434f7dcfc22bb435d23a5b2b4e428b72c7e1e144ec318d7ee65a:"
