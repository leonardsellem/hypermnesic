          "version": "repo-lines-v1:sha256:e9bacbc94df037612a6168900bb7aa9e697f46559e35b5c50e57e5ed22ac3488:"
        }
      ]
    },
    {
      "id": "claim_ea66c7e248b64674a7cb77d1fba86f5e",
      "statement": "Convergence models the projection's lag as a commit-SHA checkpoint: `changes_since_checkpoint` compares the index checkpoint to git HEAD and returns the changed markdown files (or, when the checkpoint commit is unknown or missing, every markdown file at HEAD), and replay reads committed content via `git show HEAD:<path>` so the projection is of the commit, not of a dirty working tree.",
      "evidence": [
        {
          "resource": "repo://src/hypermnesic/index.py#L461-L469",
          "version": "repo-lines-v1:sha256:16efad1d285d1dbf35b186364715ebe8f324ac7cf809daa01799701f06a7d238:"
        },
        {
          "resource": "repo://src/hypermnesic/index.py#L483-L502",
          "version": "repo-lines-v1:sha256:7df6d00bd3242047fc8a32f7562341f4e9647deb48c4aca67f520ccc48f57f1c:"
        },
