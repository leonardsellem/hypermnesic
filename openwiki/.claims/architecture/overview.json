        }
      ]
    },
    {
      "id": "claim_3d33fb0b0a8343d9928bc7edb68ba3c8",
      "statement": "Every read path runs one shared `converge()` step before serving — the MCP read tools call the backend's converge (which also invalidates the cached graph when the index advanced) and the CLI's read commands converge first — so a just-committed or edited note is recall-able on the next read with no manual reindex.",
      "evidence": [
        {
          "resource": "repo://src/hypermnesic/cli.py#L173-L190",
          "version": "repo-lines-v1:sha256:0f8ce3367ae7815733f8f09776491e0ec6b4c7e55633333b1d16d39151cdb4d2:"
        },
        {
          "resource": "repo://src/hypermnesic/converge.py#L1-L4",
          "version": "repo-lines-v1:sha256:5f1e77b38394b68a22f7e217ac379080362bb73fbe0e145032c07090a2e425b2:"
        },
        {
