    {
      "id": "claim_9cbc57208d594b7bb2e53f56e534ad6b",
      "statement": "`commit_note()` is the single sanctioned write and is git-first and ordered: path guard, then the diff-or-die frontmatter gate, then the file write, then a path-scoped `git add`/`commit` (and push when a remote exists), then the index projection, then the append-only audit entry — the agent never merges and a refusal exits before the write, so a refusal can never leave a partial write.",
      "evidence": [
        {
          "resource": "repo://src/hypermnesic/commit_note.py#L1-L14",
          "version": "repo-lines-v1:sha256:0466db0b4fdfa8f821ef96c1762973b0ae50da6035222b8508aad0d678cacbd1:"
