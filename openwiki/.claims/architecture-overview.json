  "claims": [
    {
      "id": "claim_5e5a215b45f145d19bbbd85a949b4726",
      "statement": "hypermnesic's prime invariant is that git-tracked markdown files are the single source of truth and the SQLite search index is a disposable, rebuildable projection of the committed tree rather than a database of record.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md",
          "version": "repo-file-v1:sha256:471788a330c6f652067d69f8ea7212a59c2e531fa7792199671f40a6f921352f"
        },
        {
          "resource": "repo://ARCHITECTURE.md",
          "version": "repo-file-v1:sha256:f05fb1c55d7daf2e94e756b6188d9fdcfec5f3fd3adce39000d31d1baa83806c"
        },
        {
          "resource": "repo://src/hypermnesic/__init__.py",
          "version": "repo-file-v1:sha256:421d3fde4a47c2e90e9f0f0f222e0ce195d59e6817d86ba897140735443235d3"
        }
      ]
    },
    {
      "id": "claim_0e0895bd6cbd4d6bb901592a91d08127",
      "statement": "A reindex can never lose a committed write because writes are applied to git first and the index is rebuilt from git, which is why the index needs no backups and can be deleted at any time at the cost of only a rebuild.",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md",
          "version": "repo-file-v1:sha256:f05fb1c55d7daf2e94e756b6188d9fdcfec5f3fd3adce39000d31d1baa83806c"
        },
        {
          "resource": "repo://GLOSSARY.md",
          "version": "repo-file-v1:sha256:064432c0d2587d5551296fba6b14d7e5f24825da4046496bb7824de332b4e658"
        },
        {
          "resource": "repo://tests/test_index_projection.py",
          "version": "repo-file-v1:sha256:f48209d7f04491abc0e5a0b4cfcbd98beb185dc7f6c070ae558ff8876bdcfdf8"
        }
      ]
    },
    {
      "id": "claim_f273341c6c6646c786bff3860effcd02",
      "statement": "The corpus format is plain markdown in a git repository where body wikilinks are the graph edges and frontmatter carries note metadata, so the vault stays human-readable and diffable without the engine present.",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md",
          "version": "repo-file-v1:sha256:f05fb1c55d7daf2e94e756b6188d9fdcfec5f3fd3adce39000d31d1baa83806c"
        },
        {
          "resource": "repo://src/hypermnesic/graph.py",
          "version": "repo-file-v1:sha256:545c60d026e0280747d9c5e1d6b5dc9f68f66022c9d1d2d8c6f730162fc5b4e8"
        },
        {
          "resource": "repo://src/hypermnesic/ingest.py",
          "version": "repo-file-v1:sha256:21e54cedff1e84fa22b05862ea5f04af485584e9e5a511ccdaf5d3746fb163f6"
        }
      ]
    },
    {
      "id": "claim_9e70c378fd8d49f99dfcb1b3c59ca908",
      "statement": "The index stores a commit-SHA checkpoint alongside its lexical and dense tables, and that checkpoint is what lets the engine measure how far the projection lags HEAD and converge only the delta.",
      "evidence": [
        {
          "resource": "repo://src/hypermnesic/converge.py",
          "version": "repo-file-v1:sha256:d7797f4a61b105575a7fabf5ef522cdc3bac8701181ee0242899cf63685b405e"
        },
        {
          "resource": "repo://src/hypermnesic/index.py",
          "version": "repo-file-v1:sha256:117fb19b2b3244246c78796533ebe49aeaa1bd88b224f016a3c6994d1df1be03"
        }
      ]
    },
    {
      "id": "claim_061e82e2c2bb4066a807c30f8792c604",
      "statement": "Every read path runs convergence before answering, so a just-committed note is recall-able on the next read without a manual reindex — the guarantee that lets the index remain a pure projection instead of a cache that drifts.",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md",
          "version": "repo-file-v1:sha256:f05fb1c55d7daf2e94e756b6188d9fdcfec5f3fd3adce39000d31d1baa83806c"
        },
        {
