        }
      ]
    },
    {
      "id": "claim_06b7f1329dbe47ef936a4d639b4b7cf7",
      "statement": "commit_note is the only sanctioned mutation of the corpus and runs a fixed order — write guard, frontmatter gate, file write, git commit and push, index projection, append-only audit entry — with the agent never merging.",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md",
          "version": "repo-file-v1:sha256:f05fb1c55d7daf2e94e756b6188d9fdcfec5f3fd3adce39000d31d1baa83806c"
