          "version": "repo-file-v1:sha256:4722cdfa20d1351ee5bd1aa24f09b970c219e162fa14041edd1dbbf347096d83"
        }
      ]
    },
    {
      "id": "claim_a926ec8613ef435d94e63c80d79f9c7d",
      "statement": "The dense retrieval channel is optional at runtime: when the embedding provider is unreachable, reads still return lexical and graph results and are explicitly flagged as degraded rather than silently returning thinner results.",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md",
          "version": "repo-file-v1:sha256:f05fb1c55d7daf2e94e756b6188d9fdcfec5f3fd3adce39000d31d1baa83806c"
        },
