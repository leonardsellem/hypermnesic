        }
      ]
    },
    {
      "id": "claim_5e867a8e77f6404b8733f78861f486c0",
      "statement": "The MCP server binds a specific interface at the socket level and refuses to bind 0.0.0.0 at construction, so a misconfigured bind fails loudly instead of exposing the vault broadly.",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md",
          "version": "repo-file-v1:sha256:f05fb1c55d7daf2e94e756b6188d9fdcfec5f3fd3adce39000d31d1baa83806c"
