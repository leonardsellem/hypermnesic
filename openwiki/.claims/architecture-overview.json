        }
      ]
    },
    {
      "id": "claim_a0c30ce374d94e35a86d79fc7aebd003",
      "statement": "The serving topology is exactly two network lanes: a public OAuth 2.1 /mcp endpoint with dynamic client registration, PKCE, operator consent and audience-bound revocable tokens for every remote client, and an auth-off read-only tailnet companion where tailnet membership is the boundary; descriptions of a tailnet-only system or of four lanes are superseded.",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md",
          "version": "repo-file-v1:sha256:f05fb1c55d7daf2e94e756b6188d9fdcfec5f3fd3adce39000d31d1baa83806c"
        },
