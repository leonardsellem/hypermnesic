    {
      "id": "claim_8dc5624c095a433eb5a9bea47525766b",
      "statement": "src/hypermnesic/ is deliberately a flat module layout with one module per responsibility, so retrieval, convergence, the write path, serving, provisioning, diagnostics, control surfaces, and the human knowledge surfaces each have a single owning file rather than a package hierarchy.",
