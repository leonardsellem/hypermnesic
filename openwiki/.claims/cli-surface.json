        }
      ]
    },
    {
      "id": "claim_35fce6eef42c46aeb9f15a8459ee8510",
      "statement": "local-proof is the local-first entry point that precedes any endpoint concept: against an existing vault it validates the markdown git repo, builds the projection, retrieves an answer with its repo-relative source path, and previews a write as a dry-run diff with no commit, defaulting to a lexical proof that needs no API key.",
      "evidence": [
        {
          "resource": "repo://docs/reference/cli.md",
          "version": "repo-file-v1:sha256:79e81ab97facbe01f7c03d8a1b04ee9c5879300331e15e2b3b9e602d4b823904"
