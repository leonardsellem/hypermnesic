    {
      "id": "claim_d2d1bb56d9674daab5ffbe311c525f02",
      "statement": "hypermnesic is a git-native memory layer in which a vault of plain markdown files in a self-hosted git repository is served to chat clients, coding agents, and an editor companion through one endpoint, with every memory landing as a real reviewable and revertible git commit.",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md",
          "version": "repo-file-v1:sha256:f05fb1c55d7daf2e94e756b6188d9fdcfec5f3fd3adce39000d31d1baa83806c"
        },
        {
